        },
        "options": {}
      }
    },
    {
      "id": "49787068-a9c3-4444-b979-85017156f8fc",
      "name": "Respond error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        680,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"error\": $json.error } }}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],

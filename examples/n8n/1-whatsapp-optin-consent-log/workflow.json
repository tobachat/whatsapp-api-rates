          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Opt-ins",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "phone"
          ],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "4ec83eb0-fd9d-4b0c-897a-8892576a6fd0",
      "name": "Confirm opt-out (free-form, inside window)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        960,
        520
      ],
      "parameters": {
        "resource": "message",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "operation": "send",
        "recipientPhoneNumber": "={{ $('Prepare opt-out').item.json.phone }}",
        "messageType": "text",
        "textBody": "You have been unsubscribed and will not receive further WhatsApp messages from us."
      }
    }

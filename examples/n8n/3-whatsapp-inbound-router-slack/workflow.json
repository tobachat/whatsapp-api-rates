          "mode": "id"
        },
        "text": "=*{{ $json.topic }}* from {{ $json.name }} (+{{ $json.phone }})\n>{{ $json.text }}\nFree-form reply possible until {{ $json.window_ends }} (24h window).",
        "otherOptions": {}
      }
    },

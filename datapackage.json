{
  "name": "whatsapp-api-rates",
  "title": "WhatsApp Business Platform per-message rates",
  "description": "Meta's published WhatsApp Business Platform rate cards in 16 currencies, as tidy CSV with volume tiers and a country to market table. Not affiliated with Meta.",
  "version": "2026-10-01",
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "path": "https://creativecommons.org/licenses/by/4.0/"
    }
  ],
  "contributors": [
    {
      "title": "Tobachat",
      "role": "author"
    }
  ],
  "sources": [
    {
      "title": "Meta, Pricing on the WhatsApp Business Platform",
      "path": "https://developers.facebook.com/documentation/business-messaging/whatsapp/pricing"
    }
  ],
  "resources": [
    {
      "name": "rates-2026-10-01",
      "path": "data/rates/2026-10-01.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          {
            "name": "effective_date",
            "type": "date",
            "description": "First day the rates apply (Meta Messaging account timezone)"
          },
          {
            "name": "currency",
            "type": "string",
            "description": "ISO 4217 code; Meta's own published value, never converted"
          },
          {
            "name": "market",
            "type": "string",
            "description": "Market name as written on Meta's rate card"
          },
          {
            "name": "category",
            "type": "string",
            "description": "marketing, utility, authentication, authentication_international or service"
          },
          {
            "name": "rate",
            "type": "string",
            "description": "Decimal string, per delivered message, excluding VAT; absent when Meta lists n/a"
          }
        ]
      },
      "hash": "sha256:77b943bad010e37c1e4f1a0690db05ef279bfb5f330f8a693b1eadef3737dd5d"
    },
    {
      "name": "tiers-2026-10-01",
      "path": "data/tiers/2026-10-01.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          {
            "name": "effective_date",
            "type": "date",
            "description": "First day the rates apply (Meta Messaging account timezone)"
          },
          {
            "name": "currency",
            "type": "string",
            "description": "ISO 4217 code; Meta's own published value, never converted"
          },
          {
            "name": "market",
            "type": "string",
            "description": "Market name as written on Meta's rate card"
          },
          {
            "name": "category",
            "type": "string",
            "description": "marketing, utility, authentication, authentication_international or service"
          },
          {
            "name": "tier_from",
            "type": "string",
            "description": "First message of the tier in the calendar month"
          },
          {
            "name": "tier_to",
            "type": "string",
            "description": "Last message of the tier; empty = open ended (Meta writes --)"
          },
          {
            "name": "rate_type",
            "type": "string",
            "description": "list_rate or tier_rate"
          },
          {
            "name": "rate",
            "type": "string",
            "description": "Decimal string per message"
          },
          {
            "name": "pct_vs_list",
            "type": "string",
            "description": "Decimal fraction vs the list rate, e.g. -0.05"
          }
        ]
      },
      "hash": "sha256:801c0a6b1489b59930ad71c5746d7b9d764150ba539e9a4c18f4a567da41280f"
    },

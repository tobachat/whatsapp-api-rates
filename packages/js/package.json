{
  "name": "whatsapp-pricing",
  "version": "0.1.0",
  "description": "Meta WhatsApp Business API per-message rates by country and category, with a monthly cost estimator. Zero dependencies, no network calls.",
  "license": "MIT",
  "author": "Tobachat",
  "homepage": "https://tobachat.nl/en/whatsapp-api-pricing-by-country/",
  "repository": { "type": "git", "url": "git+https://github.com/tobachat/whatsapp-api-rates.git", "directory": "js" },
  "keywords": ["whatsapp", "whatsapp-business-api", "pricing", "meta", "cost-calculator", "rates"],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./data.json": "./data.json"
  },
  "files": ["dist", "data.json", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts-postbuild.mjs",
    "test": "npm run build && node --test test/cost.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": { "typescript": "^5.6.0" }
}
